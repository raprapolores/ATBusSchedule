{
  "expo": {
    "name": "Auckland Bus Timetable",
    "slug": "ReactATBusNative",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/playstore.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.ralpholores.reactatbusnative"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0bf3bfa4-2043-4a89-afb2-06480efbb0bb"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Auckland Bus to use your location to show directions to a bus stop."
        }
      ]
    ]
  }
}
